# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Database ---
# Defaults to sqlite+aiosqlite:///./dev.db when unset.
DATABASE_URL=

# --- Octen (retrieval) ---
OCTEN_API_KEY=
OCTEN_BASE_URL=https://api.octen.ai
OCTEN_MAX_CONCURRENCY=64
OCTEN_TIMEOUT_S=10
OCTEN_CACHE_TTL_S=900

# --- OpenAI (read directly by app/openai_client.py) ---
OPENAI_API_KEY=
# Verify current model identifiers before setting these -- do not guess.
# Planner: one call per run, needs strong reasoning to plan good query breadth.
OPENAI_MODEL_PLANNER=
# Extractor/verifier: hundreds of calls per run, use the smaller/cheaper model.
OPENAI_MODEL_EXTRACTOR=
# Extractor concurrency cap -- read via app/config.py, not openai_client.py.
OPENAI_MAX_CONCURRENCY=16

# --- Scoring / list rules ---
LIST_CAP=80
MIN_EVIDENCE_PER_INVESTOR=1
FRESHNESS_MAX_AGE_DAYS=120

# --- Composio (used by composio_client.py, owned by the Composio module) ---
COMPOSIO_API_KEY=
# Auth configs — created once via `composio dev auth-configs create <name> --toolkit <slug>`,
# shared across all users; not created per-user.
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_GOOGLE_SHEETS=
COMPOSIO_AUTH_CONFIG_NOTION=
