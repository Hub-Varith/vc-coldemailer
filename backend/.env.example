# Copy to .env and fill in. .env is gitignored — never commit real keys.

# --- Database ---
# Defaults to sqlite+aiosqlite:///./dev.db when unset.
DATABASE_URL=

# --- Octen (backend/pipeline owner) ---
OCTEN_API_KEY=
OCTEN_BASE_URL=https://api.octen.ai
OCTEN_MAX_CONCURRENCY=64
OCTEN_TIMEOUT_S=10
OCTEN_CACHE_TTL_S=900

# --- OpenAI (shared) ---
OPENAI_API_KEY=
OPENAI_MODEL_PLANNER=
OPENAI_MODEL_EXTRACTOR=
OPENAI_MAX_CONCURRENCY=16

# --- Composio (Composio owner) ---
COMPOSIO_API_KEY=
# Auth configs — created once via `composio dev auth-configs create <name> --toolkit <slug>`,
# shared across all users; not created per-user.
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_GOOGLE_SHEETS=
COMPOSIO_AUTH_CONFIG_NOTION=

# --- pipeline knobs ---
LIST_CAP=80
MIN_EVIDENCE_PER_INVESTOR=1
FRESHNESS_MAX_AGE_DAYS=120
